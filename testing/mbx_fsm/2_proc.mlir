module {
  hw.module @mbx_fsm(in %clk_i : i1, in %rst_ni : i1, in %mbx_range_valid_i : i1, in %hostif_abort_ack_i : i1, in %mbx_error_set_i : i1, in %sysif_control_abort_set_i : i1, in %sys_read_all_i : i1, in %writer_close_mbx_i : i1, in %writer_last_word_written_i : i1, in %writer_write_valid_i : i1, out mbx_empty_o : i1, out mbx_write_o : i1, out mbx_read_o : i1, out mbx_sys_abort_o : i1, out mbx_ready_update_o : i1, out mbx_ready_o : i1, out mbx_irq_ready_o : i1, out mbx_irq_abort_o : i1, out mbx_state_error_o : i1) {
    %c1_i2 = hw.constant 1 : i2
    %c2_i3 = hw.constant 2 : i3
    %c-4_i3 = hw.constant -4 : i3
    %true = hw.constant true
    %c-3_i3 = hw.constant -3 : i3
    %c3_i3 = hw.constant 3 : i3
    %c1_i3 = hw.constant 1 : i3
    %c0_i3 = hw.constant 0 : i3
    %0 = seq.to_clock %clk_i
    %1 = comb.xor %rst_ni, %true : i1
    %aff_ctrl_state_q2Fq_o = seq.compreg name "aff_ctrl_state_q/q_o" %81, %0 reset %1, %c0_i3 : i3  
    %2 = comb.icmp eq %aff_ctrl_state_q2Fq_o, %c0_i3 : i3
    %3 = comb.and %2, %mbx_range_valid_i : i1
    %4 = comb.icmp eq %aff_ctrl_state_q2Fq_o, %c1_i3 : i3
    %5 = comb.icmp eq %aff_ctrl_state_q2Fq_o, %c3_i3 : i3
    %6 = comb.icmp eq %aff_ctrl_state_q2Fq_o, %c-3_i3 : i3
    %7 = comb.icmp ne %aff_ctrl_state_q2Fq_o, %c-3_i3 : i3
    %8 = comb.icmp eq %81, %c-3_i3 : i3
    %9 = comb.and %7, %8 : i1
    %10 = comb.icmp ne %aff_ctrl_state_q2Fq_o, %c3_i3 : i3
    %11 = comb.icmp eq %81, %c3_i3 : i3
    %12 = comb.and %10, %11 : i1
    %13 = comb.and %2, %mbx_range_valid_i, %writer_close_mbx_i : i1
    %14 = comb.and %5, %sys_read_all_i : i1
    %15 = comb.or %mbx_error_set_i, %sysif_control_abort_set_i, %hostif_abort_ack_i, %14 : i1
    %16 = comb.or %13, %15 : i1
    %17 = comb.xor %15, %true : i1
    %18 = comb.and %mbx_range_valid_i, %writer_close_mbx_i : i1
    %19 = comb.icmp eq %aff_ctrl_state_q2Fq_o, %c2_i3 : i3
    %20 = comb.mux %19, %writer_last_word_written_i, %sys_read_all_i : i1
    %21 = comb.mux %19, %c3_i3, %c0_i3 : i3
    %22 = comb.icmp eq %aff_ctrl_state_q2Fq_o, %c-4_i3 : i3
    %23 = comb.xor %mbx_error_set_i, %true : i1
    %24 = comb.and %2, %23 : i1
    %25 = comb.xor %2, %true : i1
    %26 = comb.xor %4, %true : i1
    %27 = comb.xor %19, %true : i1
    %28 = comb.xor %5, %true : i1
    %29 = comb.and %28, %27, %26, %25, %22 : i1
    %30 = comb.or %29, %24 : i1
    %31 = comb.mux %30, %sysif_control_abort_set_i, %20 : i1
    %32 = comb.mux %30, %c-3_i3, %21 : i3
    %33 = comb.xor %24, %true : i1
    %34 = comb.xor %18, %true : i1
    %35 = comb.or %29, %33, %34 : i1
    %36 = comb.mux %35, %aff_ctrl_state_q2Fq_o, %c3_i3 : i3
    %37 = comb.mux %6, %aff_ctrl_state_q2Fq_o, %c0_i3 : i3
    %38 = comb.xor %6, %true : i1
    %39 = comb.xor %hostif_abort_ack_i, %true : i1
    %40 = comb.and %25, %39 : i1
    %41 = comb.and %26, %40 : i1
    %42 = comb.and %27, %41 : i1
    %43 = comb.and %5, %42 : i1
    %44 = comb.and %19, %41 : i1
    %45 = comb.or %43, %44 : i1
    %46 = comb.and %23, %45 : i1
    %47 = comb.and %46, %sysif_control_abort_set_i : i1
    %48 = comb.mux %47, %c-3_i3, %37 : i3
    %49 = comb.xor %47, %true : i1
    %50 = comb.and %45, %mbx_error_set_i : i1
    %51 = comb.mux %50, %c-4_i3, %48 : i3
    %52 = comb.xor %50, %true : i1
    %53 = comb.concat %c1_i2, %writer_last_word_written_i : i2, i1
    %54 = comb.and %4, %40 : i1
    %55 = comb.and %23, %54 : i1
    %56 = comb.xor %sysif_control_abort_set_i, %true : i1
    %57 = comb.and %56, %55 : i1
    %58 = comb.and %writer_close_mbx_i, %57 : i1
    %59 = comb.mux %58, %53, %51 : i3
    %60 = comb.xor %58, %true : i1
    %61 = comb.and %55, %sysif_control_abort_set_i : i1
    %62 = comb.mux %61, %c-3_i3, %59 : i3
    %63 = comb.xor %61, %true : i1
    %64 = comb.and %54, %mbx_error_set_i : i1
    %65 = comb.mux %64, %c-4_i3, %62 : i3
    %66 = comb.xor %64, %true : i1
    %67 = comb.mux %31, %32, %36 : i3
    %68 = comb.and %2, %39 : i1
    %69 = comb.and %56, %46 : i1
    %70 = comb.and %23, %68 : i1
    %71 = comb.and %22, %28, %42 : i1
    %72 = comb.or %69, %70, %71 : i1
    %73 = comb.mux %72, %67, %65 : i3
    %74 = comb.xor %72, %true : i1
    %75 = comb.and %68, %mbx_error_set_i : i1
    %76 = comb.mux %75, %c-4_i3, %73 : i3
    %77 = comb.xor %75, %true : i1
    %78 = comb.mux %hostif_abort_ack_i, %c0_i3, %76 : i3
    %79 = comb.xor %writer_close_mbx_i, %true : i1
    %80 = comb.and %57, %79 : i1
    %81 = comb.mux %80, %aff_ctrl_state_q2Fq_o, %78 : i3
    %82 = comb.xor %80, %true : i1
    %83 = comb.and %82, %39, %77, %74, %66, %63, %60, %52, %49, %38 : i1
    %84 = comb.and %5, %23, %56, %sys_read_all_i : i1
    %_sh1 = seq.compreg sym @_sh1 %84, %0 : i1  
    %85 = comb.xor %_sh1, %true : i1
    %86 = comb.or %85, %2 : i1
    verif.assert %86 : i1
    hw.output %3, %4, %5, %6, %16, %17, %12, %9, %83 : i1, i1, i1, i1, i1, i1, i1, i1, i1
  }
}

