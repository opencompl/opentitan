    %292 = comb.xor %16, %true : i1
    verif.assert %292 : i1
    hw.output %6, %u_sck_flop2Fq_o, %csb_q, %286, %237, %239, %2, %3, %4, %5, %cmd_speed_q, %19, %58, %56, %46 : i1, i1, i1, i4, i1, i1, i1, i1, i1, i1, i2, i1, i1, i1, i1
  }
}

