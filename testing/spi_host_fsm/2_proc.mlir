    hw.output %6, %u_sck_flop2Fq_o, %csb_q, %277, %232, %234, %2, %3, %4, %5, %cmd_speed_q, %19, %57, %55, %45 : i1, i1, i1, i4, i1, i1, i1, i1, i1, i1, i2, i1, i1, i1, i1
  }
}

